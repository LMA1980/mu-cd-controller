# ==============================================================================
# MuCD Continuous Delivery Controller Configuration Environment
# Path: /etc/mu-cd-controller/controller.env (Permissions: 0600 mu-cd-controller:mu-cd-controller)
# ==============================================================================

# Logical controller node identifier for telemetry spans
MU_CD_CONTROLLER_NODE_ID=node-a

# mu-ci-controller base URL for cluster idle worker polling (/api/cluster/nodes)
MU_CD_CONTROLLER_CI_URL=https://controller.ci.internal:8443

# mu-registry base URL and bearer token file for canary promote/taint calls
MU_CD_CONTROLLER_REGISTRY_URL=https://registry.ci.internal:8444
# MU_CD_CONTROLLER_REGISTRY_TOKEN_FILE=/etc/mu-cd-controller/registry_token

# Target mu-cd-agent mTLS IPC port and optional logical-to-host mapping
MU_CD_CONTROLLER_AGENT_PORT=8446
# MU_CD_CONTROLLER_NODE_MAP=node-a=node-a.cluster.internal,node-b=node-b.cluster.internal,worker-riscv64=worker-riscv64.cluster.internal

# step-ca mTLS client credentials for agent, CI controller, registry, and hub RPCs
# MU_CD_CONTROLLER_TLS_CA_CERT=/etc/mu-cd-controller/ca.crt
# MU_CD_CONTROLLER_TLS_CLIENT_CERT=/etc/mu-cd-controller/client.crt
# MU_CD_CONTROLLER_TLS_CLIENT_KEY=/etc/mu-cd-controller/client.key

# Optional CD status, gate, and rollout trigger HTTP listener (/api/cd/*)
# MU_CD_CONTROLLER_API_ADDR=127.0.0.1:8447
# MU_CD_CONTROLLER_API_TOKEN_FILE=/etc/mu-cd-controller/cd_api_token
# MU_CD_CONTROLLER_PROXY_SECRET_FILE=/etc/mu-cd-controller/proxy_secret
# MU_CD_CONTROLLER_OPERATOR_USERS=operator-one

# Idle worker polling backoff tuning
# MU_CD_CONTROLLER_IDLE_WAIT_TIMEOUT_SECS=120
# MU_CD_CONTROLLER_IDLE_POLL_INITIAL_MS=500
# MU_CD_CONTROLLER_IDLE_POLL_MAX_MS=10000
# MU_CD_CONTROLLER_IDLE_JITTER_PERCENT=20

# Optional mu-observable-hub SLO RPC endpoint and mu-observable-collector MUOB sink
# MU_OBSERVABLE_HUB_ADDR=observe.ci.internal:9445
# MU_OBSERVABLE_COLLECTOR_ADDR=127.0.0.1:4319

# Tracing and logging level
RUST_LOG=info,mu_cd_controller=debug
